<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Logo -->
        <TextView
            android:id="@+id/tvMsg"
            android:layout_width="251dp"
            android:layout_height="92dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="3dp"
            android:layout_marginTop="-5dp"
            android:text="@string/cinefast"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <!-- Select Items -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Items"
            android:textColor="#BBBBBB"
            android:textSize="14sp"
            android:layout_marginTop="-20dp"/>

        <!-- Snacks & Drinks -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Snacks and Drinks"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp"/>

        <!-- Snack Card 1 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#1E2A38">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- Food Image Background -->
                <LinearLayout
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:background="#F39C12"
                    android:gravity="center"
                    android:padding="10dp"
                    android:orientation="vertical"
                    android:backgroundTint="#FFFFFF"
                    android:layout_marginEnd="16dp"
                    android:clipToOutline="true">

                    <ImageView
                        android:id="@+id/imgPopcorn"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/popcorn"
                        android:scaleType="centerInside"/>
                </LinearLayout>

                <!-- Right Side Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Item Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Popcorn"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <!-- Description -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Large / Buttered"
                        android:textColor="#BBBBBB"
                        android:textSize="14sp"
                        android:layout_marginTop="2dp"/>

                    <!-- Price -->
                    <TextView
                        android:id="@+id/tvPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$5"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="6dp"/>

                    <!-- Quantity Row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical">

                        <!-- Minus -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMinus"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:text="-"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/white"
                            app:backgroundTint="#E53935"
                            android:padding="0dp"/>


                        <!-- Quantity -->
                        <TextView
                            android:id="@+id/tvQuantity"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:gravity="center"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"/>

                        <!-- Plus -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPlus"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:text="+"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/white"
                            app:backgroundTint="#E53935"
                            android:padding="0dp"/>


                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>
        <!--Snack card 2-->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#1E2A38">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- Food Image Background -->
                <LinearLayout
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:background="#F39C12"
                    android:gravity="center"
                    android:padding="10dp"
                    android:orientation="vertical"
                    android:backgroundTint="#FFFFFF"
                    android:layout_marginEnd="16dp"
                    android:clipToOutline="true">

                    <ImageView
                        android:id="@+id/imgPopcorn2"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/nachos"
                        android:scaleType="centerInside"/>
                </LinearLayout>

                <!-- Right Side Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Item Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nachos"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <!-- Description -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Large / Buttered"
                        android:textColor="#BBBBBB"
                        android:textSize="14sp"
                        android:layout_marginTop="2dp"/>

                    <!-- Price -->
                    <TextView
                        android:id="@+id/tvPrice2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$5"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="6dp"/>

                    <!-- Quantity Row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical">

                        <!-- Minus -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMinus2"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:text="-"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/white"
                            app:backgroundTint="#E53935"
                            android:padding="0dp"/>


                        <!-- Quantity -->
                        <TextView
                            android:id="@+id/tvQuantity2"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:gravity="center"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"/>

                        <!-- Plus -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPlus2"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:text="+"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/white"
                            app:backgroundTint="#E53935"
                            android:padding="0dp"/>


                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>
        <!--snack3-->
        <FrameLayout
            xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
        <androidx.cardview.widget.CardView
            android:id="@+id/last"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#1E2A38">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- Food Image Background -->
                <LinearLayout
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:background="#F39C12"
                    android:gravity="center"
                    android:padding="10dp"
                    android:orientation="vertical"
                    android:backgroundTint="#FFFFFF"
                    android:layout_marginEnd="16dp"
                    android:clipToOutline="true">

                    <ImageView
                        android:id="@+id/imgPopcorn3"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/drink"
                        android:scaleType="centerInside"/>
                </LinearLayout>

                <!-- Right Side Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Item Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Drinks"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <!-- Description -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Large / Buttered"
                        android:textColor="#BBBBBB"
                        android:textSize="14sp"
                        android:layout_marginTop="2dp"/>

                    <!-- Price -->
                    <TextView
                        android:id="@+id/tvPrice3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$5"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="6dp"/>

                    <!-- Quantity Row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical">

                        <!-- Minus -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMinus3"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:text="-"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/white"
                            app:backgroundTint="#E53935"
                            android:padding="0dp"/>


                        <!-- Quantity -->
                        <TextView
                            android:id="@+id/tvQuantity3"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:gravity="center"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"/>

                        <!-- Plus -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPlus3"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:text="+"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/white"
                            app:backgroundTint="#E53935"
                            android:padding="0dp"/>


                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>
<!--snack card 4 -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="200dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#1E2A38">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <!-- Food Image Background -->
                    <LinearLayout
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:background="#F39C12"
                        android:gravity="center"
                        android:padding="10dp"
                        android:orientation="vertical"
                        android:backgroundTint="#FFFFFF"
                        android:layout_marginEnd="16dp"
                        android:clipToOutline="true">

                        <ImageView
                            android:id="@+id/imgPopcorn4"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:src="@drawable/candy"
                            android:scaleType="centerInside"/>
                    </LinearLayout>

                    <!-- Right Side Content -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Item Name -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Candies"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <!-- Description -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Large / Buttered"
                            android:textColor="#BBBBBB"
                            android:textSize="14sp"
                            android:layout_marginTop="2dp"/>

                        <!-- Price -->
                        <TextView
                            android:id="@+id/tvPrice4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$5"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginTop="6dp"/>

                        <!-- Quantity Row -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical">

                            <!-- Minus -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMinus4"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:text="-"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@android:color/white"
                                app:backgroundTint="#E53935"
                                android:padding="0dp"/>


                            <!-- Quantity -->
                            <TextView
                                android:id="@+id/tvQuantity4"
                                android:layout_width="40dp"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/white"
                                android:textSize="18sp"
                                android:gravity="center"
                                android:layout_marginStart="8dp"
                                android:layout_marginEnd="8dp"/>

                            <!-- Plus -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPlus4"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:text="+"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@android:color/white"
                                app:backgroundTint="#E53935"
                                android:padding="0dp"/>


                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>
            <!--confirm button-->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- This empty view pushes everything below it down -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/confirm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Confirm Tickets"
                    android:textColor="@android:color/white"
                    app:backgroundTint="#FF5722"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="20dp"
                    android:layout_marginTop="370dp"
                    android:layout_alignParentBottom="true"
                    />

            </LinearLayout>

        </FrameLayout>
    </LinearLayout>

</ScrollView>
